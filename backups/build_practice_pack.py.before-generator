def main():
    existing = json.loads(SOURCE.read_text(encoding="utf-8"))
    counts = {s: sum(q.get("subject") == s for q in existing) for s in TARGETS}

    print("Existing question counts:")
    for subject, target in TARGETS.items():
        print(f"{subject}: {counts[subject]} existing; {target} extra needed")

    print("\nGenerator scaffold checked.")
    print("No new questions written yet.")
    print("Reason: each question needs a defensible answer key and solution.")

if __name__ == "__main__":
    main()
